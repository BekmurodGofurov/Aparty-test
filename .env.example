# Copy to .env (git-ignored) and fill in real values before `docker compose up`.
# Avoid special characters such as @ : / in passwords: they are embedded in connection URLs.

POSTGRES_USER=<database user>
POSTGRES_PASSWORD=<strong database password>

REDIS_PASSWORD=<strong redis password>

RABBITMQ_USER=<broker user>
RABBITMQ_PASSWORD=<strong broker password>

# Shared by IAM, Catalog and Order services. Use a long random value.
JWT_SECRET_KEY=<long random secret>
JWT_ALGORITHM=HS256

ADMIN_USERNAME=<admin username>
ADMIN_PASSWORD=<strong admin password>

CORS_ORIGINS=http://localhost:5173
IMGBB_API_KEY=<imgbb api key>

# Telegram login (OpenID Connect). Register the bot's Web Login in @BotFather to get these.
# The redirect URI must be registered there too and must point to the frontend callback page.
TELEGRAM_CLIENT_ID=<bot id from BotFather>
TELEGRAM_CLIENT_SECRET=<client secret from BotFather>
TELEGRAM_REDIRECT_URI=https://<your domain>/auth/telegram/callback
