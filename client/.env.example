# Copy to .env. Vite reads VITE_ prefixed variables only.

# API base URL. Leave empty to use the same origin as the site: the dev server proxies /api to the gateway.
# Set it to the gateway URL (for example http://localhost:8080) to call the gateway directly.
VITE_BACKEND_API=

# `npm run dev` and `npm run share`: where /api is proxied (default http://localhost:8080) and which extra hosts
# may open the site, for example the address of an ngrok tunnel used to share the site or test Telegram login.
DEV_API_PROXY_TARGET=
DEV_ALLOWED_HOSTS=

VITE_APP_NAME=Aparty
VITE_APP_VERSION=1.0.0
