# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/iam_db
REDIS_URL=redis://:<redis password>@redis:6379
JWT_SECRET_KEY=<long random secret shared with the other services>
JWT_ALGORITHM=HS256
JWT_ISSUER=aparty-iam
JWT_AUDIENCE=aparty-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
TELEGRAM_CLIENT_ID=<bot id from BotFather>
TELEGRAM_CLIENT_SECRET=<client secret from BotFather>
TELEGRAM_REDIRECT_URI=https://<your domain>/auth/telegram/callback
ADMIN_USERNAME=<admin username>
ADMIN_PASSWORD=<strong admin password>
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
