# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/notifications_db
RABBITMQ_URL=amqp://<user>:<password>@rabbitmq:5672/
JWT_SECRET_KEY=<same secret as the IAM Service>
JWT_ALGORITHM=HS256
JWT_ISSUER=aparty-iam
JWT_AUDIENCE=aparty-api
IAM_SERVICE_URL=http://iam-service:8000
# Leave BOT_TOKEN empty to disable Telegram messages (the site bell still works).
BOT_TOKEN=<telegram bot token>
SITE_URL=https://<your domain>
CORS_ORIGINS=http://localhost:5173
