# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/orders_db
RABBITMQ_URL=amqp://<user>:<password>@rabbitmq:5672/
JWT_SECRET_KEY=<same secret as the IAM Service>
JWT_ALGORITHM=HS256
JWT_ISSUER=aparty-iam
JWT_AUDIENCE=aparty-api
CATALOG_SERVICE_URL=http://catalog-service:8001
IAM_SERVICE_URL=http://iam-service:8000
CORS_ORIGINS=http://localhost:5173
